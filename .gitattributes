# 行尾符规范：文本自动归一，避免 CRLF/LF 混行污染 diff
* text=auto

# Dart / Kotlin / Markdown / 配置统一 LF
*.dart text eol=lf
*.kt text eol=lf
*.java text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.toml text eol=lf
*.txt text eol=lf
*.gradle text eol=lf
*.kts text eol=lf
*.properties text eol=lf

# PowerShell 脚本保持 CRLF（Windows 原生，PowerShell 5.1 兼容）
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Rust 统一 LF
*.rs text eol=lf

# C/C++ 统一 LF
*.c text eol=lf
*.h text eol=lf
*.cpp text eol=lf
*.cc text eol=lf
*.hpp text eol=lf

# JS 统一 LF
*.js text eol=lf

# 二进制文件不转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.icns binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.jar binary
*.so binary
*.dll binary
*.dylib binary
*.a binary
*.o binary
*.exe binary
*.rmeta binary
*.rlib binary
*.class binary
*.keystore binary
*.jks binary
*.bin binary
*.pdf binary
*.zip binary
*.7z binary
*.gz binary
*.wasm binary
